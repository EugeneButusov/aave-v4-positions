{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    /* `nodenext` models Node's real resolution, including package.json
       `exports`. The legacy `node10` this replaced was removed outright in
       TypeScript 7, and is what blocked every type-aware tool built on it. */
    "module": "nodenext",
    "moduleResolution": "nodenext",

    /* NestJS relies on both of these: decorators are the DI surface, and the
       emitted metadata is what lets the injector resolve constructor types. */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Strict everywhere. Financial arithmetic is the whole point of this
       service; an implicit `any` on a balance is a silent wrong number. */
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,

    "declaration": true,
    "sourceMap": true,
    "incremental": true,
    "pretty": true
  }
}
