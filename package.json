{
  "name": "aave-v4-positions",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "backfill": "pnpm --filter @aave-v4-positions/indexer backfill",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter './packages/**' build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "clean": "rimraf 'apps/*/dist' 'apps/*/coverage' 'packages/**/dist' 'packages/**/coverage' 'apps/*/node_modules/.cache' 'packages/**/node_modules/.cache' '**/*.tsbuildinfo' coverage",
    "dev:api": "pnpm --filter @aave-v4-positions/api start:dev",
    "dev:indexer": "pnpm --filter @aave-v4-positions/indexer start:dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run build:packages && oxlint --type-aware",
    "lint:fix": "pnpm run build:packages && oxlint --type-aware --fix",
    "prepare": "lefthook install && pnpm run build:packages",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm run build:packages && tsc -p tsconfig.json --noEmit && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "lefthook": "^2.1.10",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
