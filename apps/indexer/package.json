{
  "name": "@aave-v4-positions/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Ingests Aave v4 Spoke and Hub events and folds them into position state",
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node --require @packages/telemetry/start --enable-source-maps dist/main.js",
    "backfill": "node --require @packages/telemetry/start --enable-source-maps dist/backfill.js",
    "start:dev": "pnpm run build && concurrently -k -n tsc,app -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --require @packages/telemetry/start --enable-source-maps dist/main.js\"",
    "start:debug": "pnpm run build && concurrently -k -n tsc,app -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --inspect --require @packages/telemetry/start --enable-source-maps dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "migrate": "node dist/migrate.js",
    "reconcile:hub": "node --require @packages/telemetry/start --enable-source-maps dist/reconcile-hub.js",
    "reconcile:positions": "node --require @packages/telemetry/start --enable-source-maps dist/reconcile-positions.js",
    "enrich:tokens": "node --require @packages/telemetry/start --enable-source-maps dist/enrich-tokens.js",
    "price:reserves": "node --require @packages/telemetry/start --enable-source-maps dist/price-reserves.js"
  },
  "dependencies": {
    "@aave-positions/events": "workspace:*",
    "@aave-positions/positions": "workspace:*",
    "@clickhouse/client": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@packages/clickhouse": "workspace:*",
    "@packages/indexing": "workspace:*",
    "@packages/migrations": "workspace:*",
    "@packages/ops": "workspace:*",
    "@packages/postgres": "workspace:*",
    "@packages/prices": "workspace:*",
    "@packages/telemetry": "workspace:*",
    "@packages/token-metadata": "workspace:*",
    "postgres": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@types/supertest": "catalog:",
    "pino-pretty": "^13.1.3",
    "supertest": "catalog:"
  }
}
