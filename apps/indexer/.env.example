# Copy to .env for local development. Every variable is validated at boot;
# an invalid value fails the process rather than defaulting silently.

NODE_ENV=development

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Human-readable log output. Leave false in any deployed environment so logs
# stay as one JSON object per line.
LOG_PRETTY=true

# Probe-only HTTP server. No business endpoints are mounted here.
INDEXER_PORT=3001
INDEXER_HOST=0.0.0.0

# Seconds to keep draining after SIGTERM before the process closes.
SHUTDOWN_GRACE_SECONDS=10

# --- chain -------------------------------------------------------------------
# Required, no defaults. Verified against the providers on the first iteration:
# an indexer pointed at the wrong chain produces plausible, wrong data.
CHAIN_ID=1

# Comma-separated and tried in order, so the first is the preferred provider.
# Capability varies: measured eth_getLogs ranges run from 50 blocks to 10,000,
# and some public endpoints serve no history at all.
RPC_URLS=https://eth.drpc.org

# --- indexing ----------------------------------------------------------------
# How deep a reorg is assumed to reach. Read by the reorg detector, never by the
# loop. `finalized` was measured trailing the tip by 75 blocks.
FINALITY_DEPTH=128

# Main Spoke genesis. Only used when there is no stored cursor — which, until
# the cursor is persisted, is every start. Re-indexing is harmless: writes are
# idempotent, it just costs the requests again.
INDEXER_START_BLOCK=24720899

# Blocks per dispatch while catching up. Halved at runtime if a provider rejects
# the range as too wide.
INDEXER_MAX_RANGE_SIZE=1000

INDEXER_POLL_INTERVAL_MS=4000
INDEXER_RPC_TIMEOUT_MS=10000

# How long the loop may fail to progress before /health/ready starts failing.
INDEXER_STALL_THRESHOLD_MS=300000

# Set false to boot the probes without indexing anything.
INDEXER_AUTOSTART=true


# --- events ------------------------------------------------------------------
# Which Spoke to follow. Defaults to the Main Spoke on mainnet; it is a
# processor parameter, so a second Spoke is a second registration rather than
# an edit.
MAIN_SPOKE_ADDRESS=0x94e7a5dcbe816e498b89ab752661904e2f56c485

# --- clickhouse --------------------------------------------------------------
# The append-only event log. `docker compose up` provides one; for a standalone
# instance to run the tests against:
#   docker run --rm -p 8123:8123 -e CLICKHOUSE_SKIP_USER_SETUP=1 \
#     clickhouse/clickhouse-server:26.3-alpine
# Apply the schema before starting the indexer — it never migrates at boot,
# because replicas would race the same DDL:
#   pnpm --filter @aave-v4-positions/indexer migrate
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
