# Copy to .env for local development. Every variable is validated at boot;
# an invalid value fails the process rather than defaulting silently.

NODE_ENV=development

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Human-readable log output. Leave false in any deployed environment so logs
# stay as one JSON object per line.
LOG_PRETTY=true

# Probe-only HTTP server. No business endpoints are mounted here.
INDEXER_PORT=3001
INDEXER_HOST=0.0.0.0

# Seconds to keep draining after SIGTERM before the process closes.
SHUTDOWN_GRACE_SECONDS=10

# --- chain -------------------------------------------------------------------
# Required, no defaults. Verified against the providers on the first iteration:
# an indexer pointed at the wrong chain produces plausible, wrong data.
CHAIN_ID=1

# Comma-separated and tried in order, so the first is the preferred provider.
# Capability varies: measured eth_getLogs ranges run from 50 blocks to 10,000,
# and some public endpoints serve no history at all.
RPC_URLS=https://eth.drpc.org

# --- indexing ----------------------------------------------------------------
# How deep a reorg is assumed to reach. Read by the reorg detector, never by the
# loop. `finalized` was measured trailing the tip by 75 blocks.
FINALITY_DEPTH=128

# Main Spoke genesis. Only used when there is no stored cursor, so on a cold
# start and never again — raising it later to skip history does nothing until
# the stored cursor is cleared. See the postgres section below for how.
INDEXER_START_BLOCK=24720899

# Blocks per dispatch while catching up. Halved at runtime if a provider rejects
# the range as too wide.
INDEXER_MAX_RANGE_SIZE=1000

INDEXER_POLL_INTERVAL_MS=4000
INDEXER_RPC_TIMEOUT_MS=10000

# How long the loop may fail to progress before /health/ready starts failing.
INDEXER_STALL_THRESHOLD_MS=300000

# Set false to boot the probes without indexing anything.
INDEXER_AUTOSTART=true


# --- events ------------------------------------------------------------------
# Which Spoke to follow. Defaults to the Main Spoke on mainnet; it is a
# processor parameter, so a second Spoke is a second registration rather than
# an edit.
#
# Not part of the cursor key. Repointing an existing deployment at a different
# Spoke resumes from the cursor built for the first one and skips that Spoke's
# history — clear the stored state, or backfill the range explicitly.
MAIN_SPOKE_ADDRESS=0x94e7a5dcbe816e498b89ab752661904e2f56c485

# --- clickhouse --------------------------------------------------------------
# The append-only event log. `docker compose up` provides one; for a standalone
# instance to run the tests against:
#   docker run --rm -p 8123:8123 -e CLICKHOUSE_SKIP_USER_SETUP=1 \
#     clickhouse/clickhouse-server:26.3-alpine
# Apply the schema before starting the indexer — it never migrates at boot,
# because replicas would race the same DDL:
#   pnpm --filter @aave-v4-positions/indexer migrate
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- postgres ----------------------------------------------------------------
# Where the indexer records its own position: the cursor, and the reorg
# detector's window of recent block headers. Two small tables — one row and
# about 129 more per chain — but they are what makes a restart resume instead of
# re-indexing from INDEXER_START_BLOCK. For a standalone instance:
#   docker run --rm -p 5432:5432 -e POSTGRES_HOST_AUTH_METHOD=trust \
#     postgres:18-alpine
# The same `migrate` command applies this schema too.
#
# To reset an indexer — stop it first, or the running loop rewrites the row
# within a poll interval:
#   DELETE FROM indexer_cursor        WHERE chain_id = 1;
#   DELETE FROM indexer_block_headers WHERE chain_id = 1;
# Deleting only the cursor is safe; bootstrap clears the window itself. Deleting
# only the window usually is too, but if that block has since been reorged out
# the detector answers `unrecoverable` and wants the pair.
POSTGRES_URL=postgres://postgres@localhost:5432/postgres

# Token metadata. Filled in by a worker beside the pipeline rather than by a
# block processor: an AddAsset wakes it directly, and the loop — which stops
# dispatching when it is caught up, stalled or not started — is no longer in the
# path of the initial check or of any retry. The retry delay applies only after
# a run that left a gap open; a clean run arms no timer at all and sleeps until
# something is listed.
TOKEN_METADATA_RETRY_MS=60000
# Four, not unbounded: a public endpoint rate-limits a burst long before
# seventeen calls become slow, and the transport does not retry.
TOKEN_METADATA_CONCURRENCY=4
# Whether to fill metadata at all. Its own switch rather than INDEXER_AUTOSTART:
# that one says whether to walk the chain, this says whether to read ERC-20s.
TOKEN_METADATA_AUTOSTART=true

# Reserve prices, read from the Spoke's own oracle on a timer of their own.
#
# Not a block processor, and not driven by the indexing loop. Token metadata is
# on-chain state that changes on chain, so enrichment can wait for the event
# that changes it. An oracle's feeds move off chain on their own schedule and no
# Aave event announces one, so this runs on wall-clock time — which also means a
# quiet chain, a stalled indexer or INDEXER_AUTOSTART=false no longer freeze the
# prices. One eth_call covers the whole Spoke.
#
# The oracle is per-Spoke and keyed by reserveId, so it travels with
# MAIN_SPOKE_ADDRESS above — a second Spoke brings a second oracle over a
# disjoint id space.
MAIN_SPOKE_ORACLE_ADDRESS=0x99b2b6cea9c3d2fd8f4d90f86741c44b212a6127
# A minute is already far more often than the feeds move: roughly one
# AnswerUpdated per hour per aggregator (§7.4).
RESERVE_PRICE_REFRESH_MS=60000
# Shorter than the refresh, deliberately. One price standing still while its
# neighbours moved is worse than all of them being a minute old, because §7.1
# weighs collateral against debt and only the ratio is wrong.
RESERVE_PRICE_RETRY_MS=15000
# Whether to poll at all. Its own switch rather than INDEXER_AUTOSTART: that one
# says whether to walk the chain, this says whether to read an oracle, and the
# point of the split is that those fail independently.
RESERVE_PRICE_AUTOSTART=true
