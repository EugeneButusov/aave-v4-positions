# Copy to .env for local development. Every variable is validated at boot;
# an invalid value fails the process rather than defaulting silently.

NODE_ENV=development

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Human-readable log output. Leave false in any deployed environment so logs
# stay as one JSON object per line.
LOG_PRETTY=true

API_PORT=3000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api

# Where Swagger UI is mounted, with the raw document at
# /$API_DOCS_PATH/openapi.json and /openapi.yaml. Always served, outside the
# global prefix, alongside the probes.
API_DOCS_PATH=docs

# Seconds to keep serving in-flight requests after SIGTERM, so a k8s rolling
# update drains the pod instead of cutting connections.
SHUTDOWN_GRACE_SECONDS=10
