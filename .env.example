# Copy to .env for local development. Every variable is read once at boot; an
# invalid value fails the process rather than defaulting silently.
#
# This file is the Rust binaries' — `api` and `migrate`. It sits at the root
# because that is where they look: the reader walks up from the working
# directory, so one file serves a `cargo run` from anywhere in the tree. The
# indexer is still Node and keeps its own, in apps/indexer/.env.example.
#
# The file is a default and never an override: anything already in the process
# environment wins, which is what makes a deployment's injected variables
# authoritative over whatever ends up on the filesystem.

# Whether there is a file to read at all, and the one variable that is never
# read from one. `production` or `test` means the process environment alone —
# so setting it here is how you stop this file being read, and the symptom is
# every value below silently reverting to its default.
APP_ENV=development

# fatal | error | warn | info | debug | trace | silent — the same seven the
# indexer's pino takes, so one value means one thing across both services.
LOG_LEVEL=debug

# Human-readable log output. Leave false in any deployed environment so logs
# stay as one JSON object per line.
LOG_PRETTY=true

API_HOST=0.0.0.0
API_PORT=3000
API_GLOBAL_PREFIX=api

# Where the documentation is mounted, with the document itself at
# /$API_DOCS_PATH/openapi.json and /openapi.yaml. Always served, outside the
# global prefix, alongside the probes.
API_DOCS_PATH=docs

# The three Swagger UI files the page loads, which the image copies in and a
# checkout does not have. Absent, the document is still served and the viewer
# in front of it is not — point this at a swagger-ui-dist to get the page.
API_DOCS_ASSETS=/usr/share/api/docs

# Seconds to keep serving in-flight requests after SIGTERM, so a k8s rolling
# update drains the pod instead of cutting connections. Readiness fails first.
SHUTDOWN_GRACE_SECONDS=10

# Where the fold lives. Must be the database the indexer writes to. Also the
# two of these five that `migrate` reads.
#
# `https://` connects over TLS against the host's certificate roots. It is not
# the default here because the compose server speaks plain HTTP. The exception
# is off unless it is named explicitly, so an injected production URL cannot
# silently downgrade. `SSL_CERT_FILE=/path/to/ca-bundle.pem` replaces the host
# roots for both database clients when a deployment uses a private CA.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_ALLOW_INSECURE_HTTP=true
CLICKHOUSE_DATABASE=aave
CLICKHOUSE_USER=aave
CLICKHOUSE_PASSWORD=aave

# Where the indexer records how far it got. Read-only from the API: it stamps
# every response with the block it is serving as of, and writes nothing.
#
# `sslmode` is honoured, and this driver takes three spellings: `disable`,
# `prefer` (the default, which falls back to plaintext against a server with no
# TLS, as the compose one is) and `require`. `require` here verifies the
# certificate against the selected roots, so it is libpq's `verify-full` rather
# than its `require`. The `verify-ca` and `verify-full` spellings are refused at
# boot naming the variable, as is `sslrootcert`; use the process-wide
# `SSL_CERT_FILE` described above for a private certificate authority.
POSTGRES_URL=postgres://aave:aave@localhost:5432/aave

# What a slow dependency costs, rather than what it costs to wait one out.
# Every one of these is a deadline in milliseconds, and leaving one unset is
# the default rather than "no limit" — deadpool's own default is no timer at
# all, which turns a slow database into a dead pod.
POSTGRES_MAX_CONNECTIONS=4
POSTGRES_WAIT_MS=250
POSTGRES_CONNECT_MS=2000
POSTGRES_RECYCLE_MS=1000
POSTGRES_STATEMENT_MS=5000
CLICKHOUSE_MAX_EXECUTION_MS=10000

# The whole request. Bounding this is also what bounds the drain: `axum`'s
# graceful shutdown waits for what is in flight, and nothing in flight can now
# outlast this, which is comfortably inside compose's `stop_grace_period`.
API_REQUEST_TIMEOUT_MS=10000

# Signs pagination cursors. Required, at least 32 bytes, and it MUST be the
# same on every replica — each process signs with its own copy, so a per-pod
# secret gives pagination that fails only under load and only sometimes.
# Generate one with: openssl rand -hex 32
POSITIONS_CURSOR_SECRET=change-me-to-32-or-more-random-characters

# Above this, a response reports itself stale. Not the indexer's stall
# threshold: that one decides whether to drain traffic from a pod, this one
# tells a reader their numbers are a minute old.
API_SYNC_STALE_AFTER_SECONDS=60

# Above this, a page reports its prices stale. It measures how long since the
# indexer last read the oracle, never how long since a feed last moved — an hour
# without a Chainlink update is normal behaviour, and a threshold set from feed
# cadence would flag healthy feeds forever. Five refresh intervals.
API_PRICE_STALE_AFTER_SECONDS=300

# --- telemetry -----------------------------------------------------------
# Read through this service's own config, like everything above: telemetry is
# compiled in, so `main` parses one environment and hands the group down. There
# is no preloaded SDK reading these ahead of it.
OTEL_SDK_DISABLED=false
# Required when telemetry is on; the process refuses to boot without it, because
# every signal is grouped by service.name and an unnamed service produces
# telemetry that is present, plausible and impossible to attribute.
OTEL_SERVICE_NAME=api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# always_on | always_off | traceidratio | parentbased_always_on |
# parentbased_always_off | parentbased_traceidratio
OTEL_TRACES_SAMPLER=parentbased_always_on
# The ratio the two traceidratio samplers take, between 0 and 1.
OTEL_TRACES_SAMPLER_ARG=1.0
