{
  "uid": "aave-v4-positions",
  "title": "Aave v4 positions",
  "tags": ["aave"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Sync & lag",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Indexing lag",
      "description": "Head minus cursor. The number that had no way out of the process before — you could not graph it, only wait for the stall alarm.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "indexer_lag_blocks",
          "legendFormat": "blocks behind"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cursor and head",
      "description": "Which of the two stopped moving. A flat cursor under a climbing head is a stall; both flat is a quiet chain.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "indexer_cursor_block",
          "legendFormat": "cursor"
        },
        {
          "refId": "B",
          "expr": "indexer_head_block",
          "legendFormat": "head"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Iteration outcomes",
      "description": "The retry rate, visible long before anything crosses INDEXER_STALL_THRESHOLD_MS.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(indexer_iterations_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time since progress",
      "description": "Graphable before it becomes a readiness failure, which is the whole point of having it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "indexer_progress_age_seconds",
          "legendFormat": "seconds"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dispatch range size",
      "description": "Only ever halves. A falling line is a provider refusing our range width and degrading throughput.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "indexer_range_size",
          "legendFormat": "blocks per range"
        }
      ]
    },
    {
      "type": "row",
      "title": "Providers",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests by provider",
      "description": "Which endpoint is actually answering. With `rank: false` the list is a preference order, so anything below the top line means the preferred one is not serving.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(rpc_client_requests_total[1m]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failovers and errors",
      "description": "A step on failovers is the preferred provider dying. Errors are split by type, so a 429 is distinguishable from a timeout.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(rpc_client_failovers_total[5m]))",
          "legendFormat": "failover to {{provider}}"
        },
        {
          "refId": "B",
          "expr": "sum by (provider, error_type) (rate(rpc_client_errors_total[1m]))",
          "legendFormat": "{{provider}} {{error_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RPC latency p95, by method",
      "description": "Per JSON-RPC method, which the URL alone cannot tell you — every call is POST / with the method in the body.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, rpc_method) (rate(rpc_client_duration_seconds_bucket[5m])))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Processor duration p95",
      "description": "Dispatch is sequential, so the slowest processor is the whole loop’s latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, processor) (rate(indexer_processor_duration_seconds_bucket[5m])))",
          "legendFormat": "{{processor}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "API",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per second, by route",
      "description": "From instrumentation-http, which emits this histogram without a line of our own code. Probes are excluded at the instrumentation, so this is real traffic only.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"api\"}[1m]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency, p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"api\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"api\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"api\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "row",
      "title": "ClickHouse",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Queries and inserts per second",
      "description": "Scraped from ClickHouse itself, not inferred from our spans — so it also counts anything a human runs against the same server.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(ClickHouseProfileEvents_Query_total[1m])",
          "legendFormat": "queries"
        },
        {
          "refId": "B",
          "expr": "rate(ClickHouseProfileEvents_InsertedRows_total[1m])",
          "legendFormat": "rows inserted"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Parts and merges",
      "description": "The number a projection changes. A rising part count with no merges is what a too-frequent insert pattern looks like from the server's side.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ClickHouseAsyncMetrics_TotalPartsOfMergeTreeTables",
          "legendFormat": "active parts"
        },
        {
          "refId": "B",
          "expr": "ClickHouseMetrics_Merge",
          "legendFormat": "merges running"
        }
      ]
    },
    {
      "type": "row",
      "title": "Postgres",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connections in use",
      "description": "The pool is capped at four per process, deliberately. This is what saturation would look like before a readiness probe started timing out behind an in-flight cursor save.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (pg_stat_database_numbackends{datname=\"aave\"})",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Commits and rollbacks per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit_total{datname=\"aave\"}[1m])",
          "legendFormat": "commit"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback_total{datname=\"aave\"}[1m])",
          "legendFormat": "rollback"
        }
      ]
    }
  ]
}
