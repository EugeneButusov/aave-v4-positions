{
  "name": "@packages/prices",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "What a reserve is priced at, read from the Spoke's own oracle on a timer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/migrations','dist/migrations',{recursive:true})\"",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aave-dao/aave-address-book": "catalog:",
    "@clickhouse/client": "catalog:",
    "@nestjs/common": "catalog:",
    "@packages/clickhouse": "workspace:*",
    "@packages/indexing": "workspace:*",
    "@packages/postgres": "workspace:*",
    "postgres": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@aave-positions/events": "workspace:*",
    "@aave-positions/positions": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@packages/migrations": "workspace:*"
  }
}
